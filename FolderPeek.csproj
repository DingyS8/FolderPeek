<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FolderPeek</AssemblyName>
    <RootNamespace>FolderPeek</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>1.0.1</Version>
    <!-- exe single-file comprimido: ~173 MB → bem menor; custa uns ms de descompressão na inicialização -->
    <EnableCompressionInSingleFile Condition="'$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
    <Product>FolderPeek</Product>
    <Description>Peek inside desktop folders: a Windows 11-style popup with the folder's contents.</Description>
    <Copyright>Copyright (c) 2026 ViniDingy · MIT License</Copyright>
    <!-- WinForms só é usado para o NotifyIcon da bandeja; o DPI (PMv2) vem do app.manifest, que é o certo para WPF -->
    <NoWarn>$(NoWarn);WFO0003;WFO5001;WFAC010</NoWarn>
  </PropertyGroup>

</Project>
