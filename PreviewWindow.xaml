<Window x:Class="FolderPeek.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderPeek" Width="384" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Focusable="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <!-- Paleta no estilo flyout escuro do Windows 11 -->
        <SolidColorBrush x:Key="Surface" Color="#F2272727"/>
        <SolidColorBrush x:Key="Stroke" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="Fg" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="FgDim" Color="#A3FFFFFF"/>
        <SolidColorBrush x:Key="Hover" Color="#15FFFFFF"/>
        <SolidColorBrush x:Key="Pressed" Color="#0BFFFFFF"/>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra de rolagem fina (a padrão do WPF destoa no tema escuro) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Margin" Value="0,2,3,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" CornerRadius="3" Background="#4DFFFFFF"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="T" Property="Background" Value="#80FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PeekList" TargetType="ListBox">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="SV" Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PeekItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0,4,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="8,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Item_MouseDown"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Item_MouseUp"/>
        </Style>

        <DataTemplate x:Key="EntryTemplate">
            <Grid Height="38">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon, Mode=OneTime}" Width="16" Height="16"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Name, Mode=OneTime}" Foreground="{StaticResource Fg}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Meta, Mode=OneTime}" Foreground="{StaticResource FgDim}"
                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding SizeText, Mode=OneTime}" Foreground="{StaticResource FgDim}"
                           FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10"
                           Foreground="{StaticResource FgDim}" VerticalAlignment="Center"
                           Visibility="{Binding ChevronVisibility, Mode=OneTime}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Margem de 12 = espaço da sombra (área transparente, cliques passam direto) -->
    <Grid Margin="12">
        <Border CornerRadius="8" Background="{StaticResource Surface}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.45" Color="Black"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="8" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho -->
                <Grid Margin="8,8,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;"
                            Click="Back_Click" Visibility="Collapsed" ToolTip="Voltar"/>
                    <Image x:Name="HeaderIcon" Grid.Column="1" Width="20" Height="20" Margin="6,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="{StaticResource FgDim}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="OpenButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE8A7;"
                            Click="Open_Click" ToolTip="Abrir no Explorador de Arquivos"/>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{StaticResource Stroke}"/>

                <Grid Grid.Row="2">
                    <ListBox x:Name="EntryList" Style="{StaticResource PeekList}"
                             ItemContainerStyle="{StaticResource PeekItem}"
                             ItemTemplate="{StaticResource EntryTemplate}"
                             MaxHeight="440" Margin="0,4"/>
                    <TextBlock x:Name="StatusText" Margin="16,14" Foreground="{StaticResource FgDim}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>

                <TextBlock x:Name="FooterText" Grid.Row="3" Margin="14,0,14,8" FontSize="11"
                           Foreground="{StaticResource FgDim}" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
