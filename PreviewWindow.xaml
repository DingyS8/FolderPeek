<Window x:Class="FolderPeek.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderPeek" Width="392" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Focusable="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display">

    <!--
      Fundo = acrílico do próprio Windows 11 (DWMSBT_TRANSIENTWINDOW), com cantos
      arredondados, borda e sombra desenhados pelo DWM. Por isso a janela NÃO é
      AllowsTransparency (janela "layered" não recebe backdrop do sistema).
      Cores de destaque (Accent*) são DynamicResource, lidas do Windows a cada abertura.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="FgDim" Color="#B3FFFFFF"/>
        <SolidColorBrush x:Key="FgFaint" Color="#80FFFFFF"/>
        <SolidColorBrush x:Key="Stroke" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="Tint" Color="#40141414"/>
        <SolidColorBrush x:Key="NeutralHover" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="AccentSolid" Color="#FF60CDFF"/>
        <SolidColorBrush x:Key="AccentFill" Color="#3360CDFF"/>
        <SolidColorBrush x:Key="AccentStroke" Color="#7060CDFF"/>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentFill}"/>
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmento do caminho (clicável) -->
        <Style x:Key="Crumb" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="5,3">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentFill}"/>
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmento atual (último): destaque, sem hover -->
        <Style x:Key="CrumbCurrent" TargetType="Button" BasedOn="{StaticResource Crumb}">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Padding="5,3">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra de rolagem fina; ganha a cor de destaque no hover -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Margin" Value="0,2,3,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" CornerRadius="3" Background="#40FFFFFF"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="T" Property="Background" Value="{DynamicResource AccentSolid}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="T" Property="Background" Value="{DynamicResource AccentSolid}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Grade de ícones (como "Ícones grandes" do Explorer) -->
        <Style x:Key="PeekGrid" TargetType="ListBox">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" Margin="6,6,0,6"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="SV" Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PeekTile" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="86"/>
            <Setter Property="Height" Value="96"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="6" Padding="4,6,4,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentFill}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentStroke}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Item_MouseDown"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Item_MouseUp"/>
            <EventSetter Event="MouseEnter" Handler="Item_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="Item_MouseLeave"/>
        </Style>

        <DataTemplate x:Key="TileTemplate">
            <StackPanel>
                <Grid Width="48" Height="48" HorizontalAlignment="Center">
                    <Image Source="{Binding Icon}" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <TextBlock Text="{Binding Name, Mode=OneTime}" Foreground="{StaticResource Fg}"
                           Margin="0,5,0,0" TextAlignment="Center" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" MaxHeight="32" LineHeight="16"
                           LineStackingStrategy="BlockLineHeight"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- leve escurecimento sobre o acrílico para contraste do texto -->
        <Border Background="{StaticResource Tint}"/>

        <Grid x:Name="ContentRoot">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Slide"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho: voltar · ícone · caminho clicável · abrir -->
            <Grid Margin="8,8,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;"
                        Click="Back_Click" Visibility="Collapsed"/>
                <Image x:Name="HeaderIcon" Grid.Column="1" Width="20" Height="20" Margin="4,0,2,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel x:Name="Crumbs" Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" ClipToBounds="True"/>
                <Button x:Name="OpenButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE8A7;"
                        Click="Open_Click"/>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{StaticResource Stroke}"/>

            <Grid Grid.Row="2">
                <ListBox x:Name="EntryList" Style="{StaticResource PeekGrid}"
                         ItemContainerStyle="{StaticResource PeekTile}"
                         ItemTemplate="{StaticResource TileTemplate}"
                         MaxHeight="404"/>
                <TextBlock x:Name="StatusText" Margin="16,22" Foreground="{StaticResource FgDim}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- Rodapé: resumo da pasta, ou detalhes do item sob o mouse -->
            <Border Grid.Row="3" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="FooterText" Margin="14,7,14,8" FontSize="11"
                           Foreground="{StaticResource FgFaint}" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Grid>
</Window>
